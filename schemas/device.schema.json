{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevicePack",
  "type": "object",
  "properties": {
    "adapter": {
      "anyOf": [
        {
          "$ref": "#/$defs/AdapterCaps"
        },
        {
          "type": "null"
        }
      ]
    },
    "aka": {
      "description": "Search aliases and model numbers.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "battery": {
      "anyOf": [
        {
          "$ref": "#/$defs/BatteryCaps"
        },
        {
          "type": "null"
        }
      ]
    },
    "category": {
      "$ref": "#/$defs/Category"
    },
    "client": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClientCaps"
        },
        {
          "type": "null"
        }
      ]
    },
    "compute": {
      "anyOf": [
        {
          "$ref": "#/$defs/Compute"
        },
        {
          "type": "null"
        }
      ]
    },
    "drive": {
      "anyOf": [
        {
          "$ref": "#/$defs/DriveCaps"
        },
        {
          "type": "null"
        }
      ]
    },
    "form": {
      "$ref": "#/$defs/Cap2",
      "default": "unknown"
    },
    "id": {
      "type": "string"
    },
    "india": {
      "description": "A label for the parts list. Never part of a verdict.",
      "$ref": "#/$defs/Cap3",
      "default": "unknown"
    },
    "kind": {
      "$ref": "#/$defs/PackKind"
    },
    "label": {
      "type": "string"
    },
    "network": {
      "anyOf": [
        {
          "$ref": "#/$defs/NetCaps"
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "description": "Shown in the inspector. No rule reads them.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "os_support": {
      "description": "Keyed by OS pack id.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Cap24"
      }
    },
    "ports": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ports"
        },
        {
          "type": "null"
        }
      ]
    },
    "power": {
      "$ref": "#/$defs/Power",
      "default": {
        "idle_w": "unknown",
        "input": "unknown",
        "load_w": "unknown"
      }
    },
    "released": {
      "description": "Year of release.",
      "$ref": "#/$defs/Cap",
      "default": "unknown"
    },
    "router": {
      "anyOf": [
        {
          "$ref": "#/$defs/RouterCaps"
        },
        {
          "type": "null"
        }
      ]
    },
    "storage": {
      "anyOf": [
        {
          "$ref": "#/$defs/StorageCaps"
        },
        {
          "type": "null"
        }
      ]
    },
    "ups": {
      "anyOf": [
        {
          "$ref": "#/$defs/UpsCaps"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "category",
    "label"
  ],
  "$defs": {
    "AccelApi": {
      "type": "string",
      "enum": [
        "vaapi",
        "qsv",
        "nvenc",
        "amf",
        "videotoolbox",
        "v4l2m2m",
        "rkmpp"
      ]
    },
    "AdapterCaps": {
      "type": "object",
      "properties": {
        "host_side": {
          "description": "What it plugs into.",
          "$ref": "#/$defs/Cap23",
          "default": "unknown"
        },
        "needs_power": {
          "description": "An external power brick is required.",
          "$ref": "#/$defs/Cap6",
          "default": "unknown"
        },
        "provides": {
          "$ref": "#/$defs/AdapterProvides",
          "default": {
            "bays": "unknown",
            "nic": "unknown",
            "usb": "unknown"
          }
        },
        "uas": {
          "$ref": "#/$defs/Cap6",
          "default": "unknown"
        }
      },
      "additionalProperties": false
    },
    "AdapterProvides": {
      "type": "object",
      "properties": {
        "bays": {
          "$ref": "#/$defs/Cap13",
          "default": "unknown"
        },
        "nic": {
          "$ref": "#/$defs/Cap10",
          "default": "unknown"
        },
        "usb": {
          "$ref": "#/$defs/Cap12",
          "default": "unknown"
        }
      },
      "additionalProperties": false
    },
    "AdminAccess": {
      "type": "string",
      "enum": [
        "full",
        "limited",
        "isp_only"
      ]
    },
    "Arch": {
      "type": "string",
      "enum": [
        "x86_64",
        "aarch64",
        "armv7",
        "armv6",
        "riscv64",
        "ppc64le",
        "s390x"
      ]
    },
    "Availability": {
      "type": "string",
      "enum": [
        "sold_new",
        "used_common",
        "import_only",
        "discontinued"
      ]
    },
    "Basis": {
      "description": "How good the source behind a value is.",
      "oneOf": [
        {
          "description": "The maker's spec page, datasheet, manual or official documentation.",
          "type": "string",
          "const": "official"
        },
        {
          "description": "An independent measurement published by a named reviewer.",
          "type": "string",
          "const": "review"
        },
        {
          "description": "A forum, wiki, issue tracker or user report.",
          "type": "string",
          "const": "community"
        }
      ]
    },
    "BatteryCaps": {
      "type": "object",
      "properties": {
        "firmware_charge_limit": {
          "description": "A charge limit set in firmware, independent of the OS.",
          "$ref": "#/$defs/Cap6",
          "default": "unknown"
        },
        "wh": {
          "$ref": "#/$defs/Cap5",
          "default": "unknown"
        }
      },
      "additionalProperties": false
    },
    "Bay": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "interface": {
          "$ref": "#/$defs/BayKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "interface",
        "count"
      ]
    },
    "BayKind": {
      "type": "string",
      "enum": [
        "sata_2_5",
        "sata_3_5",
        "m2_nvme",
        "m2_sata",
        "msata",
        "sd_card"
      ]
    },
    "Cap": {
      "description": "One capability value. It is a plain value in a teaching pack, a value with\nits source in a real one, or the word `unknown`.\n\nRead by hand rather than as a derived untagged enum: that keeps the error\nmessages about the value itself, and keeps the WebAssembly small.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "basis": {
              "$ref": "#/$defs/Basis"
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            },
            "retrieved_at": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "value": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            }
          },
          "required": [
            "value",
            "source",
            "retrieved_at"
          ]
        },
        {
          "$ref": "#/$defs/UnknownMark"
        },
        {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      ]
    },
    "Cap10": {
      "description": "One capability value. It is a plain value in a teaching pack, a value with\nits source in a real one, or the word `unknown`.\n\nRead by hand rather than as a derived untagged enum: that keeps the error\nmessages about the value itself, and keeps the WebAssembly small.",
